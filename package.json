{
  "name": "dst-recorder",
  "version": "1.0.0",
  "description": "Screen recorder for macOS and Windows: screen, system audio and microphone without extra drivers",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "predev": "install-electron",
    "dev": "vite",
    "prebuild": "node scripts/clean-release.js",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "prebuild:mac": "node scripts/clean-release.js",
    "build:mac": "vue-tsc --noEmit && vite build && electron-builder --mac",
    "prebuild:win": "node scripts/clean-release.js",
    "build:win": "vue-tsc --noEmit && vite build && electron-builder --win",
    "electron:dev": "vite",
    "preelectron:build": "node scripts/clean-release.js",
    "electron:build": "vite build && electron-builder",
    "preview": "vite preview",
    "compile": "vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "lint-ci": "npx eslint ./ --max-warnings 0 --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.33.0",
    "@popperjs/core": "^2.11.8",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitejs/plugin-vue": "6.0.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "bootstrap": "^5.3.7",
    "bootstrap-vue-3": "^0.5.1",
    "electron": "45.2.1",
    "electron-builder": "^26.15.7",
    "eslint": "^9.33.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "sass": "^1.69.5",
    "typescript": "^5.2.2",
    "vite": "7.0.4",
    "vite-plugin-electron": "^0.15.5",
    "vue": "3.5.17",
    "vue-router": "4.5.1",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "electron-log": "5.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "electron-winstaller",
      "vue-demi"
    ]
  },
  "packageManager": "pnpm@10.33.4"
}
