{
  "appId": "com.dstrecorder.pro",
  "productName": "Dst-Recorder",
  "publish": null,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "node_modules/**/*",
    "package.json",
    "src/assets/camera.icns",
    "src/assets/camera.ico",
    "src/assets/camera.png",
    "src/assets/tray/**/*"
  ],
  "asar": false,
  "afterPack": "builder/after-pack.js",
  "mac": {
    "icon": "src/assets/camera.icns",
    "category": "public.app-category.productivity",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "extendInfo": {
      "LSUIElement": true,
      "NSMicrophoneUsageDescription": "Dst-Recorder записывает ваш голос вместе с экраном.",
      "NSAudioCaptureUsageDescription": "Dst-Recorder записывает звук компьютера вместе с экраном: собеседников, видео, уведомления."
    }
  },
  "win": {
    "icon": "src/assets/camera.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
